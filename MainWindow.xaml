<Window x:Class="BmtExporter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BMT Temperature Exporter" Width="1120" Height="740" MinWidth="780" MinHeight="540"
    Background="#F0F4F5" Foreground="#152B35" FontFamily="Segoe UI" FontSize="13"
    AllowDrop="True" DragOver="OnDrag" Drop="OnDrop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#A9BDC2"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="BMT Temperature Exporter" FontSize="29" FontWeight="SemiBold"/>
            <TextBlock Margin="0,3,0,14" Foreground="#405A66" Text="Testo 890-2  ·  Preview release  ·  Celsius"/>
            <WrapPanel>
                <Button Click="OpenFiles">Open BMT files…</Button>
                <Button Click="OpenFolder">Import folder…</Button>
                <Button Click="ChooseSync">Folder Sync…</Button>
                <Button x:Name="StopButton" Click="StopSync" IsEnabled="False">Stop sync</Button>
                <Button Click="LoadReference">Load IRSoft reference…</Button>
            </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel>
                <Button Click="ChooseOutput">Output folder…</Button>
                <Button Name="ExportButton" Click="ExportSelected" Background="#C8EBE4" FontWeight="SemiBold">Export selected</Button>
                <Button Click="SelectAll">Select all</Button>
                <TextBlock x:Name="OutputText" Margin="4,4,0,6" MaxWidth="550" TextTrimming="CharacterEllipsis"/>
            </WrapPanel>
            <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="Status" Text="Open or drop BMT files to begin." TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="SyncStatus" Text="Folder Sync off" TextTrimming="CharacterEllipsis" Foreground="#405A66" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Files" SelectionMode="Extended" SelectionChanged="OnSelection"
                     DisplayMemberPath="Name" BorderBrush="#C0D0D3"/>
            <Border Grid.Column="2" Background="White" BorderBrush="#C0D0D3" BorderThickness="1" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="Details" FontWeight="SemiBold" Text="No image selected" TextWrapping="Wrap"/>
                    <TextBlock DockPanel.Dock="Top" x:Name="ValidationText" Foreground="#49616B" TextWrapping="Wrap" Margin="0,5,0,8"/>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="Pixel" Text="Move over the thermal image to read a pixel." Margin="0,8,0,0"/>
                    <TabControl>
                        <TabItem Header="Thermal">
                            <Grid Background="#172A31">
                                <Image x:Name="Thermal" Stretch="Uniform" MouseMove="OnPixel" MouseLeave="LeavePixel"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Visible">
                            <Grid Background="#172A31">
                                <TextBlock x:Name="NoVisible" Text="No visible image available" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="Visible" Stretch="Uniform"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
